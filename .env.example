# 管理后台令牌（必填，至少 16 个字符，不能用下面的示例值；可以用 openssl rand -hex 24 生成）
ADMIN_TOKEN=change-me-to-a-long-random-string

# 国内构建（Docker Hub、proxy.golang.org、Alpine 官方源访问不畅时）取消下面几行的注释：
# GOPROXY=https://goproxy.cn,direct
# GO_IMAGE=m.daocloud.io/docker.io/library/golang:1.27-alpine
# RUNTIME_IMAGE=m.daocloud.io/docker.io/library/alpine:3.22
# ALPINE_MIRROR=https://mirrors.aliyun.com
