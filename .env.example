# 管理后台令牌（必填，至少 16 个字符，不能用下面的示例值；可以用 openssl rand -hex 24 生成）
ADMIN_TOKEN=change-me-to-a-long-random-string

# 加密数据库和导出文件里的上游 Key、告警 Webhook（建议设置，至少 16 个字符，可以用 openssl rand -hex 32 生成）。
# 设置后务必保管好：丢了它，已加密的 Key 就打不开，网关会拒绝启动。更换时把旧值填到 SECRET_KEY_PREVIOUS 重启一次。
# SECRET_KEY=
# SECRET_KEY_PREVIOUS=

# 数据库：默认用内置 SQLite，不用配置。
# 使用已有的 PostgreSQL 时填写连接地址（密码里的特殊字符要做 URL 编码）：
# DATABASE_URL=postgres://airoute:password@db.example.com:5432/airoute?sslmode=require
# 用 docker-compose.postgres.yml 一起启动 PostgreSQL 时只需设置密码（建议 openssl rand -hex 16）：
# POSTGRES_PASSWORD=

# 网关在反向代理 / 负载均衡后面时，填写可信的代理地址（IP 或 CIDR，逗号分隔；private 表示所有内网地址），
# 登录失败锁定才会按真实客户端 IP 计算：
# TRUSTED_PROXIES=private

# 国内构建（Docker Hub、proxy.golang.org、Alpine 官方源访问不畅时）取消下面几行的注释：
# GOPROXY=https://goproxy.cn,direct
# GO_IMAGE=m.daocloud.io/docker.io/library/golang:1.27-alpine
# RUNTIME_IMAGE=m.daocloud.io/docker.io/library/alpine:3.22
# ALPINE_MIRROR=https://mirrors.aliyun.com
