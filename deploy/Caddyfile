# Load balancer for docker-compose.cluster.yml: spreads requests over every
# ai-route container (found through Docker's DNS) and streams responses
# without buffering.
:8080 {
	reverse_proxy {
		dynamic a ai-route 8080 {
			refresh 5s
		}
		lb_policy round_robin
		# an instance that is restarting: try another one (only for
		# connection failures, so a request is never sent twice)
		lb_try_duration 5s
		fail_duration 10s
		flush_interval -1
	}
}
